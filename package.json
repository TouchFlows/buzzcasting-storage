{
	"name": "buzzcasting-storage",
	"type": "module",
	"version": "3.22.2",
	"packageManager": "pnpm@11.5.2",
	"private": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TouchFlows/buzzcasting-storage.git"
	},
	"author": {
		"name": "Mark Tamis, TouchFlows SAS",
		"email": "mark.tamis@touchflows.com"
	},
	"exports": {
		".": {
			"types": "./dist/buzzcasting-storage.d.ts",
			"import": "./dist/buzzcasting-storage.esm.js",
			"default": "./dist/buzzcasting-storage.esm.js"
		}
	},
	"module": "./dist/buzzcasting-storage.esm.js",
	"types": "./dist/buzzcasting-storage.d.ts",
	"typings": "./dist/buzzcasting-storage.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"start": "vite",
		"docs": "typedoc",
		"build": "tsc && vite build",
		"changelog": "changelogen --release",
		"release": "pnpm test && pnpm run build && changelogen --release && git push --follow-tags",
		"lint": "eslint . --fix",
		"test": "vitest --run",
		"test:watch": "vitest",
		"test:coverage": "vitest --coverage"
	},
	"dependencies": {
		"buzzcasting-utils": "^1.14.2",
		"dexie": "^4.4.7",
		"idb-keyval": "^6.3.0",
		"ndjson-readablestream": "^1.4.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^10.0.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@types/node": "^26.6.11",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"@vitest/coverage-v8": "^5.1.2",
		"camelcase": "^10.0.0",
		"changelogen": "^0.6.2",
		"eslint": "^10.15.0",
		"lint-staged": "^17.6.2",
		"typedoc": "^0.28.20",
		"typedoc-plugin-markdown": "^4.14.1",
		"typescript": "^6.0.0",
		"vite": "^8.3.8",
		"vite-plugin-dts": "^5.1.2",
		"vitest": "^5.1.2"
	},
	"lint-staged": {
		"*.ts": "npm run lint"
	}
}
