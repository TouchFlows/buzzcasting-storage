#!/usr/bin/env bash
# Pre-push guard: a thin wrapper around check-git-credentials.sh, so the token
# pattern and the redaction live in exactly one place.
#
# Installed as a symlink into each repository's .git/hooks/pre-push by
# install-hooks.sh, so the script's own location is resolved through the symlink
# before the checker is looked for next to it. Git passes the refs being pushed
# on stdin; this hook never reads them, it only inspects config, so it cannot
# interfere with a push that has nothing to hide.

set -uo pipefail

# Resolve through the symlink without `readlink -f`: BSD readlink (macOS) has no
# -f, and silently finding no checker would make the hook a no-op there.
target="${BASH_SOURCE[0]}"
while [ -L "$target" ]; do
	link_dir=$(cd -P "$(dirname "$target")" && pwd)
	target=$(readlink "$target")
	case "$target" in
	/*) ;;
	*) target="$link_dir/$target" ;;
	esac
done
script_dir=$(cd -P "$(dirname "$target")" && pwd)
checker="$script_dir/check-git-credentials.sh"

if [ ! -f "$checker" ]; then
	echo "pre-push: cannot find $checker - credential check skipped" >&2
	exit 0
fi

# Scan the workspace that holds this repository, not just this one: a token in a
# sibling repository is the same exposure, and the scan costs milliseconds.
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
root=$(dirname "$top")

rc=0
bash "$checker" "$root" || rc=$?

case "$rc" in
0) exit 0 ;;
1)
	echo "pre-push: push blocked. Rewrite the remote as https://github.com/<owner>/<repo>.git (auth comes from 'gh auth git-credential'), then revoke the token." >&2
	exit 1
	;;
*)
	echo "pre-push: credential check could not run (exit $rc) - push allowed without it" >&2
	exit 0
	;;
esac
